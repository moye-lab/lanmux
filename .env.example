# LanMux — 环境变量模板（v1.0.1）
#
# v1.0.0 起环境变量主名改为 LANMUX_*；旧 .env 里的 HUB_* / FENLIU_*
# 仍被接受（LANMUX_* 优先），无需改动即可升级。
#
# Docker 单镜像部署（推荐）：
#   复制本文件为 .env，实际上所有密码字段均可留空：
#   - ADMIN_PASSWORD 留空：首次打开 http://<IP>:8086 在网页向导里设置
#   - SS_PASSWORD / MIHOMO_SECRET 留空：容器首次启动自动生成高强度随机密钥并存入 SQLite
#   - LANMUX_LAN_IP 留空：host 网络模式下自动探测宿主机局域网 IP
#
#   docker compose up -d --build
#
# 二进制 + systemd 部署（备选）：
#   install.sh 仍要求显式提供 ADMIN_PASSWORD / SS_PASSWORD / MIHOMO_SECRET。

# 时区
TZ=Asia/Shanghai

# 宿主机局域网 IP（用于生成客户端 SS 链接与二维码）。
# host 模式下可留空自动探测；bridge 模式下请填写宿主机真实局域网 IP（如 192.168.1.50）。
LANMUX_LAN_IP=

# 四个端口（若与宿主机已有服务冲突，修改这里即可）
LANMUX_WEB_PORT=8086
LANMUX_SS_PORT=10001
LANMUX_MIXED_PORT=7890
LANMUX_CONTROLLER_PORT=9090

# 管理员密码（可选，留空则在网页首次设置；至少 8 位）
ADMIN_PASSWORD=

# SS 总节点密码（可选，Docker 单镜像留空则自动生成；装好后可在网页查看二维码或修改）
SS_PASSWORD=

# SS 加密方式：aes-128-gcm / aes-256-gcm / chacha20-ietf-poly1305 /
# 2022-blake3-aes-128-gcm / 2022-blake3-aes-256-gcm / 2022-blake3-chacha20-poly1305
SS_CIPHER=aes-128-gcm

# Mihomo 控制器 Secret（可选，Docker 单镜像留空则自动生成）
MIHOMO_SECRET=

# Mixed（HTTP/SOCKS5）入口鉴权账号/密码（可选，留空 = 不鉴权）
LANMUX_MIXED_AUTH_USER=
LANMUX_MIXED_AUTH_PASS=

# metacubexd 面板路径：Docker 下默认自动启用内置 /data/mihomo/ui；设为 none 可禁用
LANMUX_EXTERNAL_UI=

# ---- 以下仅在本地构建 Docker 镜像或使用二进制安装器时加速使用 ----
# GitHub 镜像加速前缀（如 https://gh-proxy.com 或 https://ghfast.top）
GITHUB_MIRROR=
# pip 镜像源（如 https://pypi.tuna.tsinghua.edu.cn/simple）
PIP_INDEX_URL=

# 二进制安装器（install.sh）版本钉选与镜像源
MIHOMO_VERSION=1.19.34
METACUBEXD_VERSION=1.276.0
MIHOMO_MIRROR=
GEODATA_MIRROR=

# Persistent /data normally preserves bundled assets. Set to 1 for one startup
# after an image upgrade to refresh GeoIP/GeoSite/Country.mmdb + metacubexd.
LANMUX_REFRESH_ASSETS=0
